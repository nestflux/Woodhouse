# Supabase — Required for all functionality
NEXT_PUBLIC_SUPABASE_URL=           # Supabase project URL (Client + Server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anonymous key, RLS-restricted (Client + Server)
SUPABASE_SERVICE_ROLE_KEY=          # Supabase admin key, bypasses RLS (Edge Functions only)
DATABASE_URL=                       # Direct Postgres connection string (Migrations only)

# Anthropic — Required for AI agents
ANTHROPIC_API_KEY=                  # Claude API access (Edge Functions only)

# Job Search APIs — Required for job discovery
SERPAPI_API_KEY=                    # Google Jobs search via SerpAPI (Edge Functions only)
JSEARCH_API_KEY=                    # JSearch via RapidAPI (Edge Functions only)

# Stripe — Required for billing
STRIPE_SECRET_KEY=                  # Stripe billing server-side (Server Actions / API Routes)
STRIPE_WEBHOOK_SECRET=              # Stripe webhook signature verification (API Routes)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # Stripe client-side checkout (Client)

# SendGrid — Required for email features
SENDGRID_WEBHOOK_SECRET=            # Email inbound webhook verification (API Routes)

# Langfuse — Required for LLM observability
LANGFUSE_SECRET_KEY=                # Langfuse LLM observability (Edge Functions only)
LANGFUSE_PUBLIC_KEY=                # Langfuse project identifier (Edge Functions only)
LANGFUSE_BASE_URL=                  # Langfuse API endpoint, e.g. https://cloud.langfuse.com (Edge Functions only)

# Sentry — Required for error tracking
SENTRY_DSN=                         # Sentry error tracking (Server + Edge Functions)

# App
NEXT_PUBLIC_APP_URL=                # Application base URL, e.g. http://localhost:3000 (Client + Server)
